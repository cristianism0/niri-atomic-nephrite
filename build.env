FEDORA_VERSION=45
BASE_IMAGE=quay.io/fedora/fedora-bootc:${FEDORA_VERSION}
DEFAULT_FS=btrfs

IMAGE_NAME=fedora-niri-atomic-nephrite
IMAGE_TAG=latest
REGISTRY=ghcr.io/cristianism0

# Building values - do not edit 
LOCAL_IMAGE=localhost/${IMAGE_NAME}:${IMAGE_TAG}
LOCAL_INSTALLER_IMAGE=localhost/${IMAGE_NAME}-installer:${IMAGE_TAG}
TARGET_IMAGE=${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}


ISO_LABEL="Fedora-${FEDORA_VERSION}-Niri-Nephrite"
ISO_TITLE="Fedora ${FEDORA_VERSION} Niri Atomic (Nephrite)"
