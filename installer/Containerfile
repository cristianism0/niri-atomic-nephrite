# fedora-niri-atomic-nephrite — Anaconda installer image
#
# This is NOT the desktop image. It is a Fedora bootc container with Anaconda
# and the ISO tooling, consumed by image-builder (image type: generic-iso).
#
# Reference: https://osbuild.org/docs/developer-guide/projects/image-builder/bootc-generic-iso/

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BOOTC_SOURCE_IMGREF
ARG BOOTC_TARGET_IMGREF
ARG ISO_LABEL
ARG ISO_TITLE

RUN set -eux; \
    dnf5 -y install \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        plymouth \
        default-fonts-core-sans \
        default-fonts-other-sans \
        google-noto-sans-cjk-fonts \
        xorrisofs \
        squashfs-tools \
        zram-generator-defaults \
        jq; \
    dnf5 clean all; \
    rm -rf /var/cache/dnf5 /var/cache/libdnf5

RUN set -eux; \
    mkdir -p /boot/efi; \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi

RUN set -eux; \
    : "${ISO_LABEL:?ISO_LABEL is not set}" "${ISO_TITLE:?ISO_TITLE is not set}"; \
    mkdir -p /usr/lib/image-builder/bootc; \
    printf '%s\n' \
        "label: \"${ISO_LABEL}\"" \
        "grub2:" \
        "  entries:" \
        "    - name: \"${ISO_TITLE}\"" \
        "      linux: \"/images/pxeboot/vmlinuz inst.stage2=hd:LABEL=${ISO_LABEL} console=tty0 inst.graphical selinux=0 rhgb quiet\"" \
        "      initrd: \"/images/pxeboot/initrd.img\"" \
        > /usr/lib/image-builder/bootc/iso.yaml

RUN set -eux; \
    : "${BOOTC_SOURCE_IMGREF:?BOOTC_SOURCE_IMGREF is not set}" \
      "${BOOTC_TARGET_IMGREF:?BOOTC_TARGET_IMGREF is not set}"; \
    printf '%s\n' \
        "bootc --source-imgref ${BOOTC_SOURCE_IMGREF} --target-imgref ${BOOTC_TARGET_IMGREF}" \
        > /usr/share/anaconda/interactive-defaults.ks

RUN set -eux; \
    echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd; \
    echo "install::14438:0:99999:7:::" >> /etc/shadow; \
    passwd -d root

RUN set -eux; \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives; \
    mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target; \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN set -eux; \
    ln -s /usr/lib/systemd/system/anaconda-shell@.service \
          /usr/lib/systemd/system/autovt@.service

RUN set -eux; \
    mkdir -p /usr/lib/systemd/logind.conf.d; \
    printf '%s\n' "[Login]" "ReserveVT=2" \
        > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN set -eux; \
    mkdir -p "$(realpath /root)"; \
    kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version')"; \
    DRACUT_NO_XATTR=1 dracut \
        --force -v \
        --zstd \
        --reproducible \
        --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" \
        "${kernel}"

RUN set -eux; \
    for unit in service socket; do \
        mkdir -p "/etc/systemd/user/pipewire.${unit}.d"; \
        printf '%s\n' "[Unit]" "ConditionUser=" \
            > "/etc/systemd/user/pipewire.${unit}.d/allowroot.conf"; \
    done

# Known-harmless failure in the live environment: remount-fs tries to
# remount the read-only root. Masked only here, never in the desktop image.
RUN set -eux; \
    systemctl mask systemd-remount-fs.service
